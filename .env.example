# Copy to .env (never commit .env).
# Shared secret between the Go server and the EA. Generate: openssl rand -hex 24
GOBRIDGE_TOKEN=
# Broker account (use a DEMO account while developing).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=EURUSD
# Set to enable VNC on 127.0.0.1:5900 (to watch the terminal or fix things by hand).
VNC_PASSWORD=
# Uncomment if Docker Hub rate-limits pulls.
# BASE_IMAGE=mirror.gcr.io/library/debian:trixie-slim
# GO_IMAGE=mirror.gcr.io/library/golang:1.24-bookworm
